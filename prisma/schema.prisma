generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  name      String?
  isActive  Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  emailVerified Boolean  @default(false)
  emailVerifications EmailVerification[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens RefreshToken[]
  readings      Reading[] @relation("ReadingCreatedBy")
  readingsUpdated Reading[] @relation("ReadingUpdatedBy")
  readingsDeleted Reading[] @relation("ReadingDeletedBy")
  readingRevisions ReadingRevision[] @relation("ReadingRevisionBy")
  isSuperAdmin  Boolean  @default(false)
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[]
  users       User[]
  organizationRoles OrganizationRole[]
}

model Organization {
  id                String             @id @default(uuid())
  name              String
  users             User[]
  organizationRoles OrganizationRole[]
  tanks             Tank[]
  syncMarkers       SyncMarker[]
}

model Tank {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  isActive       Boolean      @default(true)
  readings       Reading[]

  @@unique([organizationId, name])
}

model OrganizationRole {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissions    String[]

  @@unique([organizationId, roleId])
}

model EmailVerification {
  id        String              @id @default(uuid())
  userId    String              @unique
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String              @unique
  status    VerificationStatus  @default(PENDING)
  expiresAt DateTime
  createdAt DateTime            @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  used      Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model RefreshToken {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token             String         @unique // hashed, plaintext না রাখা ভালো
  revoked           Boolean        @default(false)
  expiresAt         DateTime
  createdAt         DateTime       @default(now())
  familyId          String
  replacedByTokenId String?
  replacedBy        RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces          RefreshToken[] @relation("RefreshTokenReplacement")
  graceUsedAt       DateTime?

  @@index([userId])
  @@index([familyId])
}

model Reading {
  id           String   @id
  tankId       String
  tank         Tank     @relation(fields: [tankId], references: [id], onDelete: Restrict)
  createdById  String
  createdBy    User     @relation("ReadingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  ph           Float
  temperatureC Float
  salinityPpt  Float
  oxygenMgL    Float
  note         String?
  recordedAt   DateTime
  syncedAt     DateTime @default(now())
  updatedAt    DateTime @default(now())
  updatedById  String?
  updatedBy    User?    @relation("ReadingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?    @relation("ReadingDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  revisions    ReadingRevision[]

  @@index([createdById, tankId, recordedAt])
  @@index([createdById, recordedAt, id])
  @@index([tankId, recordedAt, id])
}

enum ReadingRevisionKind {
  correction
  delete
}

// The values a reading had before a correction or a delete (T27).
model ReadingRevision {
  id                   String              @id @default(uuid())
  readingId            String
  reading              Reading             @relation(fields: [readingId], references: [id], onDelete: Restrict)
  kind                 ReadingRevisionKind
  changedById          String
  changedBy            User                @relation("ReadingRevisionBy", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt            DateTime            @default(now())
  previousUpdatedAt    DateTime
  previousTankId       String
  previousRecordedAt   DateTime
  previousPh           Float
  previousTemperatureC Float
  previousSalinityPpt  Float
  previousOxygenMgL    Float
  previousNote         String?

  @@index([readingId, changedAt])
}

enum VerificationStatus {
  PENDING
  SENT
  VERIFIED
  EXPIRED
}

enum SyncResource {
  organization
  tanks
  organizationRoles
  readings
}

model SyncMarker {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource       SyncResource
  changedAt      DateTime

  @@id([organizationId, resource])
}